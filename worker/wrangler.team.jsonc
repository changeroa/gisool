{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "gisul-team",
  "main": "src/team.ts",
  "compatibility_date": "2026-09-03",
  "compatibility_flags": [
    "global_fetch_strictly_public"
  ],
  "workers_dev": false,
  "preview_urls": false,
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  },
  "r2_buckets": [
    {
      "binding": "SKILLS_BUCKET",
      "bucket_name": "gisul-team-releases"
    }
  ],
  "vars": {
    "GITHUB_AUTH_MODE": "oauth",
    "GISUL_PUBLISH_WORKFLOW": "publish.yml"
  }
}
